# SuppliWise client — Vite build served by nginx, which also reverse-proxies
# /api and /pictures to the API container so the deployed app has ONE origin.
# That is what keeps the browser out of mixed-content and CORS territory, and it
# is why the client is built with a relative API base.
FROM node:22-alpine AS build
WORKDIR /app

COPY my-react-app/package.json my-react-app/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY my-react-app/ ./

# Relative to the page origin, so nginx answers it. See src/api.js getBaseUrl().
ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# Pinned, not `nginx:alpine`: an unpinned base means the image that answers the
# public today is not the one that was reviewed, and a tag publisher who decides
# to move `latest` (or a compromised registry) changes the reverse proxy that
# stands in front of every member. Verified to exist in the registry when this
# line was written.
FROM nginx:1.31-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
