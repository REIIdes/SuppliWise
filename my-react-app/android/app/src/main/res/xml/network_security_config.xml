<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS only, for every build.

  `cleartextTrafficPermitted="false"` is the point of this file. The previous
  version permitted cleartext to a list of LAN addresses (localhost, 10.0.2.2
  and three hard-coded 192.168.x.x entries), which is two problems at once:

    1. Cleartext means bearer tokens, OTP codes and profile images cross the
       network in the clear, readable by anything on the same Wi-Fi.
    2. The address list was hard-coded to three IPs that have nothing to do with
       this machine today. A phone on a different network silently fell through
       to `base-config`, so whether the app worked depended on which router it
       had joined — the kind of failure that reads as "the app is broken" and is
       not.

  The dev case is solved properly instead: the API serves HTTPS with a
  certificate from a local certificate authority, and the DEBUG build trusts
  that authority (see src/debug/res/xml/network_security_config.xml). Nothing
  needs to be permitted in cleartext, so nothing is.

  Trust anchors are `system` only. The development CA is deliberately NOT here —
  this file is what a release build ships, and a release APK must not trust a
  certificate authority that exists on one developer's laptop.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>