PORT=5000
MONGO_URI=mongodb://localhost:27017/suppliwise

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Signing secret for every JWT. Generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# SECURITY: an earlier revision of this file contained a REAL secret. Any
# value that has ever been committed is compromised forever (git history) —
# always generate a fresh one; never reuse a previously committed value.
JWT_SECRET=SuppliWise-2026-Secure-Token-9f4c7d1a2b!Xz

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Never "true" in production (the server refuses to boot with it set).
ALLOW_DEV_OTP_RESPONSE=false

# ── Admin bootstrap (OPTIONAL) ─────────────────────────────────────────────
# The DB-backed AdminAccount collection is the preferred store; these legacy
# env vars are only a first-boot fallback and are upserted into the database
# on startup. Generate the values with:
#   node -e "require('bcryptjs').hash('your-strong-password', 12).then(console.log)"
#   node -e "console.log(require('speakeasy').generateSecret({length: 20}).base32)"
# Never commit real values here. Plaintext admin passwords and TOTP seeds
# must live only in server/.env (gitignored) and a password manager.
ADMIN_ALIAS=Admin_Name
ADMIN_PASSWORD_HASH=Admin_Hash
ADMIN_TOTP_SECRET=AdminTOTPSecret
ADMIN_ACCOUNTS=AdminJoma|$2a$12$mMRQcVk4IxFpvOeCdVqhqueRm73wg4sO.z1pJmZej4LLf4GbXG8oO|OVVXWNR2K5KXIXL5IRZUEPSKIFFFKPDX,AdminPoli|$2a$12$Vd5UYuh0Y3RGGUYFCscNWe7C1qYfOd1puDdBL1nQH.NfYlbmssiI.|MRKCGSJKOBSTGYK6FQUV2V3SOBGCQVCJ,AdminJohn|$2a$12$ARXd.mNMcBpPLeECcyD14uIxhACTD5syvzmcIuZp5gZ0BHVr4Gjy6|LJXUEQ3TN5TTQWBVGZMEIXLJH4RWMYZF,AdminShMa|$2a$12$9t99/yaCsoDzuEfs/yOhRu72Mw6wFhq1/yIG2jMReGODS1beXZexy|NFWFEL26EERWCQTVJVRX2JRYENDSKQCQ,AdminRaNe|$2a$12$G/.hzGv1uz8aKMGHUtUF8.FwIbUR2CZIWaC5AUDu0Id1axWTACcNa|SGQ5ZASCMJRYYXPOC53A | AdminDevs | $2a$12$OYUfaoJ57aH8hx85nwIoF.dq5n7J2y/hLA4bfkABTvfbcsDGSIVou | PFMHASJDOV4USKBPHEWEGMLIME7FOMJZ


# ── Reverse proxy ──────────────────────────────────────────────────────────
# Leave false unless the app sits behind a proxy you control (nginx,
# Cloudflare, a load balancer). When "true", Express trusts X-Forwarded-For
# so rate limits and lockouts key on the real client IP instead of the
# proxy's address. When false (default), client-supplied forwarding headers
# are ignored — they are attacker-controlled and must never decide an
# IP lockout.
TRUST_PROXY=false

# Optional: talk to an explicit SMTP endpoint instead of the EMAIL_SERVICE
# preset (self-hosted relay, or Mailpit/Mailhog for local dev — set
# EMAIL_HOST=127.0.0.1 EMAIL_PORT=1025 EMAIL_SECURE=false). When EMAIL_HOST is
# set it takes precedence over EMAIL_SERVICE.
#EMAIL_HOST=smtp.example.com
#EMAIL_PORT=587
#EMAIL_SECURE=false

# ── Email (OTP delivery) ───────────────────────────────────────────────────
# Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords — never your account password.
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_FROM_NAME=SuppliWise
EMAIL_FROM_ADDRESS=your_email@gmail.com
