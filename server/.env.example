PORT=5000
MONGO_URI=mongodb://localhost:27017/suppliwise
JWT_SECRET=your_jwt_secret
OPENROUTER_API_KEY=your_openrouter_api_key
OPENAI_API_KEY=your_openai_api_key
ALLOW_DEV_OTP_RESPONSE=false
ADMIN_ALIAS=your_admin_name
ADMIN_PASSWORD_HASH=your_argonid2_password_hash
ADMIN_TOTP_SECRET=your_totp_secret
ADMIN_ACCOUNTS=AdminAlias|$argon2id$v=19$m=19456,t=2,p=1$your_salt$your_hash|your_totp_secret

# Contact address for each administrator, as alias=address pairs joined by commas.
# This is NOT a login credential — admins still sign in with their alias. It is
# a delivery address, used for account-status mail and for the two administrator
# sends below. An unparseable entry is skipped rather than half-inserted, so a
# typo cannot put a truncated address into a message.
#
# It drives two DIFFERENT sends, and the difference matters:
#
#   npm run notify-admins  (or the "Email all admins" button in the console)
#     Tells each administrator that the stored form of their credentials
#     changed. Carries NO secret, ever. Safe to re-run.
#
#   npm run send-admin-credentials  (or the "Email credentials" button)
#     A ONE-TIME hand-off: each administrator's alias, their password and their
#     authenticator key. Carries live secrets. Do not put it on a schedule.
#
# AdminNames.md records that this project's real TOTP seeds were once committed
# to a public repository. The fix was to keep every RECURRING channel
# secret-free, which is why the first send above will never grow a password
# field and the two are kept as separate code paths rather than one with a flag.
ADMIN_EMAILS=AdminAlias=admin@example.com

# Email Configuration (using Gmail as example)
# For Gmail: Use App Password (not your regular password)
# Enable 2FA on Gmail, then create App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_FROM_NAME=SuppliWise
EMAIL_FROM_ADDRESS=your_email@gmail.com



# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION SECURITY (passkeys, TOTP encryption, trusted origins)
# ─────────────────────────────────────────────────────────────────────────────
# Every value below is read at boot. In production the server REFUSES TO START
# if the security-critical ones are missing, because the failure mode each one
# prevents is invisible until a real user is affected.
#
# WEBAUTHN_RP_NAME     Shown by the authenticator ("SuppliWise"). Optional.
WEBAUTHN_RP_NAME=SuppliWise
#
# WEBAUTHN_RP_ID       A BARE DOMAIN. No scheme, no port, no path.
#                      https://app.example.com  ->  app.example.com
#                      Must be the domain that serves the web app, because the
#                      browser refuses any ceremony whose origin does not share
#                      this suffix. Required in production.
WEBAUTHN_RP_ID=
#
# WEBAUTHN_ORIGIN      Comma-separated https origins allowed to run a ceremony.
#                      No trailing slash. Must be https in production.
#                      These are ALSO trusted by CORS, so a page that can run a
#                      passkey ceremony is by definition a page the API serves.
#                      In development an unset value falls back to the loopback
#                      dev-server origins, so a fresh clone works with no setup.
WEBAUTHN_ORIGIN=
#
# WEBAUTHN_TIMEOUT_MS  How long the browser waits for the user. Optional.
#                      120000 when unset.
WEBAUTHN_TIMEOUT_MS=
#
# TOTP_ENCRYPTION_KEY  The key that encrypts authenticator seeds at rest
#                      (AES-256-GCM). REQUIRED IN PRODUCTION.
#                      Generate with:  openssl rand -base64 32
#
#                      Why it matters: a TOTP seed cannot be hashed (the server
#                      has to run HMAC over it to verify a code), so it has to be
#                      recoverable — which means it has to be encrypted. Without
#                      this key, anyone who can read the database can mint valid
#                      codes for every enrolled account, forever, with no
#                      password.
#
#                      Without it, and only outside production, the server
#                      derives a key from JWT_SECRET via HKDF. That is a real
#                      key, but it shares fate with the token-signing secret:
#                      whoever can forge tokens could also decrypt every seed.
#                      Production refuses to boot in that state.
TOTP_ENCRYPTION_KEY=
#
# TOTP_ENCRYPTION_KEY_PREVIOUS
#                      Decrypt-only predecessors during a key rotation, as
#                      comma-separated kid=base64 pairs. Live traffic re-encrypts
#                      into the new primary key as accounts touch their
#                      authenticator, and the old key is withdrawn once nothing
#                      references it. Example: k0=BASE64KEY,k-1=OLDERBASE64KEY
TOTP_ENCRYPTION_KEY_PREVIOUS=
#
# WEB_ALLOWED_ORIGINS  Comma-separated origins allowed to make CREDENTIALED
#                      requests. Required in production, together with (or
#                      instead of) WEBAUTHN_ORIGIN.
#                      Example: https://app.example.com,https://www.example.com
#
#                      Never use a wildcard. `Access-Control-Allow-Origin: *` is
#                      incompatible with credentials, and reflecting whatever
#                      Origin arrives while `Allow-Credentials: true` is set is
#                      the configuration that actually leaks data.
WEB_ALLOWED_ORIGINS=
#
# ALLOW_LAN_ORIGINS    Development only: trust any http(s)://192.168.x.x:port
#                      origin, so a phone on the same Wi-Fi can reach a dev
#                      backend. Refused in production unless set to "true",
#                      which logs a warning at boot.
ALLOW_LAN_ORIGINS=false
#
# ── SESSION LIFETIME ────────────────────────────────────────────────────────
# USER SESSIONS DO NOT EXPIRE. There is no variable for that, and there is no
# default to set: a member's session ends only when it is replaced by a newer
# sign-in, revoked at sign-out or by a password reset, or when the account is
# disabled. The one time bound that can end it is Session.expiresAt, which
# nothing in the application sets — it exists so an operator has a lever that
# does not need a code change. See utils/userSession.js.
#
# ADMIN SESSIONS DO expire. They are the higher-privilege account, and they
# end after this much inactivity.
#
# ADMIN_IDLE_MINUTES      Minutes of inactivity before an admin is signed out.
#                          Default 10. The client countdown and the server check
#                          are both driven by this, so the two cannot disagree.
#
#                          Must be a whole number between 1 and 1440. Anything
#                          else is reported at boot and the default is used —
#                          a typo here must not be able to disable the timeout.
#
# ADMIN_TOKEN_LIFETIME_MINUTES
#                          How long an admin's signed JWT is valid. Default 15.
#                          MUST be greater than ADMIN_IDLE_MINUTES or a working
#                          admin is logged out mid-task with no warning; the
#                          server refuses to boot if the two are mis-ordered.
#                          The client renews the token automatically well before
#                          this, so in practice nobody sees it.
ADMIN_IDLE_MINUTES=10
ADMIN_TOKEN_LIFETIME_MINUTES=15
#
# ── RATE LIMIT CEILINGS ────────────────────────────────────────────────────
# Per-IP request ceilings. A security ceiling is also a capacity number: a
# deployment behind a shared NAT has every user behind ONE public address, so a
# value tuned for a home connection locks out a whole school. These are
# therefore configuration rather than literals in the code.
#
# All optional. Unset, empty, or nonsense falls back to the documented default,
# and a nonsense value is reported at boot and ignored — a typo must never be
# able to switch rate limiting off.
#
# AUTH_RATE_LIMIT_MAX        /api/auth, non-loopback.        Default 20 / 15 min
# AUTH_RATE_LIMIT_MAX_LOCAL  /api/auth, loopback (dev).      Default 200 / 15 min
# AUTH_SENSITIVE_RATE_LIMIT_MAX
#                           /api/auth login, 2FA, password reset. Default 60 / 10 min
# SECURITY_RATE_LIMIT_MAX    /api/security mutating routes. Default 60 / 10 min
AUTH_RATE_LIMIT_MAX=
AUTH_RATE_LIMIT_MAX_LOCAL=
AUTH_SENSITIVE_RATE_LIMIT_MAX=
SECURITY_RATE_LIMIT_MAX=
#
# PUBLIC_WEB_URL       The address users are sent to in emailed links (password
#                      reset, security notices). Required in production.
PUBLIC_WEB_URL=
