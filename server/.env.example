PORT=5000
MONGO_URI=mongodb://localhost:27017/suppliwise
JWT_SECRET=suppliwise_jwt_secret_key_change_in_production
OPENROUTER_API_KEY=your_openrouter_api_key_here
ALLOW_DEV_OTP_RESPONSE=false
ADMIN_ALIAS=replace_with_private_admin_alias
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
ADMIN_TOTP_SECRET=replace_with_base32_totp_secret
ADMIN_ACCOUNTS=Alias|bcrypt_hash|base32_totp_secret,AnotherAlias|bcrypt_hash|base32_totp_secret

# Email Configuration (using Gmail as example)
# For Gmail: Use App Password (not your regular password)
# Enable 2FA on Gmail, then create App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_FROM_NAME=SuppliWise
EMAIL_FROM_ADDRESS=your_email@gmail.com
