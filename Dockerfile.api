# SuppliWise API — Express + Mongoose.
# TLS terminates at nginx (the container serves plain HTTP and TRUST_PROXY=true
# says so), which is also what server/utils/tls.js requires before it will boot
# in production without a certificate.
FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /app

# Install from the lockfile only, so the dependency tree is reproducible and a
# source change does not invalidate the npm layer.
COPY server/package.json server/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

COPY server/ ./

# utils/pictures.js and blockchain/ledger.js resolve these relative to the code,
# and both create files on first write. The bind mount in docker-compose.yml
# keeps them on the host so uploads and the chain anchor survive a rebuild.
RUN mkdir -p /app/uploads/pictures

EXPOSE 5000
CMD ["node", "index.js"]
